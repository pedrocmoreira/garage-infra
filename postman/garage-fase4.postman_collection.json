    {
      "name": "5. Falha: pagamento recusado",
      "item": [
        {
          "name": "Abrir OS",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{os_url}}/api/service-orders",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"customerId\": \"{{customerId}}\",\n  \"vehicleId\": \"{{vehicleId}}\",\n  \"serviceIds\": [\n    1\n  ],\n  \"parts\": [\n    {\n      \"partId\": 1,\n      \"quantity\": 1\n    }\n  ]\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set(\"osId\", pm.response.json().id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Inicia diagnóstico",
          "request": {
            "method": "POST",
            "header": [],
            "url": "{{execution_url}}/api/executions/{{osId}}/diagnosis/start"
          }
        },
        {
          "name": "Conclui diagnóstico",
          "request": {
            "method": "POST",
            "header": [],
            "url": "{{execution_url}}/api/executions/{{osId}}/diagnosis/complete"
          }
        },
        {
          "name": "Orçamento",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{billing_url}}/api/budgets/service-order/{{osId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set(\"budgetToken\", pm.response.json().publicToken);",
                  "pm.collectionVariables.set(\"budgetId\", pm.response.json().id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Cliente aprova",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{billing_url}}/api/public/budgets/{{budgetToken}}/approve",
            "auth": {
              "type": "noauth"
            }
          }
        },
        {
          "name": "Link de pagamento (preferência Mercado Pago)",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{billing_url}}/api/payments/service-order/{{osId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set(\"preferenceId\", pm.response.json().preferenceId);",
                  "console.log(\"Checkout:\", pm.response.json().checkoutUrl);"
                ]
              }
            }
          ]
        },
        {
          "name": "Cliente paga no checkout (simulador MP) - recusado",
          "request": {
            "method": "POST",
            "auth": {
              "type": "noauth"
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{mock_url}}/api/mock/checkout/{{preferenceId}}/pay",
            "body": {
              "mode": "raw",
              "raw": "{\"outcome\": \"FUND\"}"
            },
            "description": "Simula o cliente pagando no checkout. O simulador envia o webhook assinado (x-signature) para /webhooks/mercadopago do Billing. Resultados: APRO (aprovado), FUND (saldo insuficiente), OTHE (recusado), CONT (pendente)."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"pagamento FUND\", () => pm.response.to.have.status(201));"
                ]
              }
            }
          ]
        },
        {
          "name": "OS cancelada",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{os_url}}/api/service-orders/{{osId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status da OS = CANCELADA\", () => pm.expect(pm.response.json().status).to.eql(\"CANCELADA\"));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "6. Cancelamento manual",
      "item": [
        {
          "name": "Abrir OS",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{os_url}}/api/service-orders",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"customerId\": \"{{customerId}}\",\n  \"vehicleId\": \"{{vehicleId}}\",\n  \"serviceIds\": [\n    1\n  ]\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set(\"osId\", pm.response.json().id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Cancelar OS",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{os_url}}/api/service-orders/{{osId}}/cancel",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"reason\": \"Cliente desistiu\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status da OS = CANCELADA\", () => pm.expect(pm.response.json().status).to.eql(\"CANCELADA\"));"
                ]
              }
            }
          ]
        }
      ]
    }
  ]
}