# Copie para .env (cp .env.example .env) e preencha. O .env NÃO é versionado.
# Todas as informações sensíveis do ambiente ficam aqui.

# ---------- Segurança ----------
JWT_SECRET=troque-por-um-segredo-com-pelo-menos-32-caracteres
ADMIN_USERNAME=admin
ADMIN_PASSWORD=troque-esta-senha

# ---------- PostgreSQL - OS Service ----------
OS_DB_NAME=os_db
OS_DB_USER=os_user
OS_DB_PASSWORD=troque-esta-senha

# ---------- PostgreSQL - Billing Service ----------
BILLING_DB_NAME=billing_db
BILLING_DB_USER=billing_user
BILLING_DB_PASSWORD=troque-esta-senha

# ---------- MongoDB - Execution Service ----------
MONGO_ROOT_USER=execution_user
MONGO_ROOT_PASSWORD=troque-esta-senha
MONGO_DB_NAME=execution_db

# ---------- RabbitMQ ----------
RABBITMQ_USER=garage
RABBITMQ_PASSWORD=troque-esta-senha

# ---------- Provedor de pagamento (Mercado Pago) ----------
# Por padrão o billing usa o SIMULADOR (repositório payment-mock-service), que imita a API do Mercado Pago.
# O mesmo token/segredo é usado pelos dois lados (billing envia, simulador valida/assina).
MP_ACCESS_TOKEN=TEST-troque-este-token
MP_WEBHOOK_SECRET=troque-este-segredo
# URL do billing vista pelo navegador (links do e-mail e retorno do checkout)
APP_PUBLIC_BASE_URL=http://localhost:8082
# URL do checkout do simulador vista pelo navegador
MOCK_PUBLIC_BASE_URL=http://localhost:8084
# Para usar o Mercado Pago REAL: descomente, use o Access Token de teste do painel de desenvolvedor
# e uma URL pública (ngrok http 8082) para o webhook:
# MP_API_BASE_URL=https://api.mercadopago.com
# MP_NOTIFICATION_URL=https://SEU-TUNEL.ngrok.app/webhooks/mercadopago

# ---------- E-mail (MailHog local; troque por SMTP real se quiser) ----------
MAIL_HOST=mailhog
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=noreply@garagesystem.com

# ---------- Grafana ----------
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=troque-esta-senha
# Porta local do Grafana (mude se a 3000 estiver ocupada)
GRAFANA_PORT=3000
